{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:mobile",
  "outputDirectory": "dist-mobile",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://unknown-kingdom-server.onrender.com/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
