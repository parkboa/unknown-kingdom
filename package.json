{
  "name": "daeguk-monorepo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Daeguk / Unknown Kingdom monorepo: browser prototype, shared game engine, and online server.",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "start": "npm start --workspace=server",
    "build:mobile": "node scripts/build-mobile.mjs",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:archive": "bash scripts/archive-ios.sh",
    "test": "npm run test:web && npm test --workspace=packages/game-engine && npm test --workspace=server",
    "test:web": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "test:layout": "playwright test test/browser/layout-sweep.spec.js",
    "ai:promotion": "node scripts/ai-promotion-gate.mjs",
    "ai:reproduce-losses": "node scripts/reproduce-is-mcts-losses.mjs",
    "ai:open-spiel-crosscheck": "node scripts/crosscheck-open-spiel-tactics.mjs",
    "ai:estimate-hidden-prior": "node scripts/estimate-hidden-special-prior.mjs",
    "ai:validate-tactics": "node scripts/validate-grandmaster-tactics.mjs",
    "ai:probe-objectives": "node scripts/probe-objective-model-tactics.mjs",
    "ai:compare-grandmaster": "node scripts/ai-promotion-gate.mjs --candidate grandmaster --baseline grandmaster --baseline-settings experiments/grandmaster-legacy-settings.json --pairs 1 --min-pairs 1 --threshold 0.5 --max-deployments 60 --seed 20260821 --output experiments/grandmaster-comparison.json",
    "ai:is-mcts-benchmark": "node scripts/is-mcts-benchmark.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "7.6.8",
    "@capacitor/ios": "7.6.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@playwright/test": "^1.62.1"
  }
}
